{
    "manifest_version": 3,
    "name": "VidDL — Video Downloader",
    "description": "One-click extract and download videos from supported sites",
    "version": "1.0.0",
    "icons": {
        "16": "images/icon-16.png",
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    },
    "permissions": ["tabs", "activeTab"],
    "host_permissions": ["https://*/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_icon": {
            "16": "images/toolbar-16.png",
            "32": "images/toolbar-32.png"
        },
        "default_title": "Send to VidDL"
    },
    "content_scripts": [
        {
            "matches": ["https://*/*"],
            "js": ["contentScript.js"],
            "run_at": "document_idle"
        }
    ]
}
